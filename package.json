{
  "name": "comparlify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "genkit:dev": "genkit start --tsx src/ai/dev.ts",
    "genkit:watch": "genkit start --tsx --watch src/ai/dev.ts",
    "build": "npm run prisma:cat && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "postinstall": "pnpm run prisma:cat && prisma generate",
    "prisma:seed": "pnpm run prisma:cat && prisma db seed",
    "prisma:cat": "concat-cli -f prisma/schema/_base.prisma -f prisma/schema/notification.prisma -f prisma/schema/user.prisma -f prisma/schema/email.prisma -f prisma/schema/content.prisma -f prisma/schema/platform.prisma -f prisma/schema/comparison.prisma -f prisma/schema/news.prisma -f prisma/schema/community.prisma -f prisma/schema/image.prisma -f prisma/schema/tool.prisma -f prisma/schema/advertisement.prisma -f prisma/schema/analytics.prisma -f prisma/schema/stack.prisma -f prisma/schema/project.prisma -o prisma/schema.prisma",
    "prisma:migrate:dev": "pnpm run prisma:cat && prisma migrate dev",
    "generate": "prisma generate"
  },
