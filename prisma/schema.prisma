// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  onboarded     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  posts        Post[]
  comments     Comment[]
  Subscription Subscription[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  ADMIN
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

// BLOG MODELS

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String    @db.Text
  content     String    @db.Text
  image       String
  dataAiHint  String?
  published   Boolean   @default(false)
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]

  // For navigating between posts
  previousId String?  @unique
  nextId     String?  @unique
  previous   Post?    @relation("PostNavigation", fields: [previousId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  next       Post?    @relation("PostNavigation", fields: [nextId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([authorId])
}

model Comment {
  id        String        @id @default(cuid())
  content   String        @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  postId    String
  authorId  String
  status    CommentStatus @default(PENDING)

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
}

// COMPARISON MODELS
model Platform {
  id             String    @id @default(cuid())
  name           String    @unique
  website        String
  logoUrl        String
  description    String    @db.Text
  rating         Float?
  easeOfUse      Float?
  featuresRating Float?
  support        Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  features       PlatformFeature[]
  comparisonsA   Comparison[]      @relation("PlatformA")
  comparisonsB   Comparison[]      @relation("PlatformB")
}

model FeatureCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  features Feature[]
}

model Feature {
  id         String @id @default(cuid())
  name       String @unique
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  category         FeatureCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  platformFeatures PlatformFeature[]

  @@index([categoryId])
}

model PlatformFeature {
  platformId String
  featureId  String
  hasFeature Boolean
  details    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  feature  Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([platformId, featureId])
  @@index([platformId])
  @@index([featureId])
}

model Comparison {
  id           String  @id @default(cuid())
  title        String
  slug         String  @unique
  summary      String  @db.Text
  introduction String  @db.Text
  conclusion   String  @db_Text
  published    Boolean @default(false)

  platformAId String
  platformBId String

  platformA Platform @relation("PlatformA", fields: [platformAId], references: [id], onDelete: Cascade)
  platformB Platform @relation("PlatformB", fields: [platformBId], references: [id], onDelete: Cascade)

  facts     ComparisonFact[]
  faqs      ComparisonFaq[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([platformAId])
  @@index([platformBId])
}

model ComparisonFact {
  id             String     @id @default(cuid())
  comparisonId   String
  title          String
  platformAValue String
  platformBValue String
  comparison     Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@index([comparisonId])
}

model ComparisonFaq {
  id           String     @id @default(cuid())
  comparisonId String
  question     String
  answer       String     @db.Text
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@index([comparisonId])
}

model Subscription {
  id        String   @id @default(cuid())
  email     String   @unique
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}
