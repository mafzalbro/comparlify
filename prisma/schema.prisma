// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  onboarded     Boolean   @default(false)
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  reviews       Review[]
}

enum Role {
  USER
  ADMIN
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App Specific Models ---

model Platform {
  id          String   @id @default(cuid())
  name        String   @unique
  website     String
  description String   @db.Text
  logoUrl     String
  rating      Float?
  features    PlatformFeature[]
  reviews     Review[]
  comparisonsA Comparison[] @relation("PlatformA")
  comparisonsB Comparison[] @relation("PlatformB")
}

model FeatureCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  features    Feature[]
}

model Feature {
  id            String    @id @default(cuid())
  name          String    @unique
  categoryId    String
  category      FeatureCategory @relation(fields: [categoryId], references: [id])
  platforms     PlatformFeature[]
}


model PlatformFeature {
  platformId  String
  featureId   String
  hasFeature  Boolean
  details     String? @db.Text
  platform    Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  feature     Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([platformId, featureId])
}

model Post {
    id        String   @id @default(cuid())
    title     String
    slug      String   @unique
    description String @db.Text
    content   String   @db.LongText
    image     String
    dataAiHint String?
    published Boolean  @default(false)

    authorId  String
    author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Review {
  id          String   @id @default(cuid())
  rating      Int
  content     String   @db.Text
  platformId  String
  platform    Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Comparison {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  summary       String   @db.Text
  content       String   @db.LongText
  published     Boolean  @default(false)
  
  platformAId   String
  platformBId   String
  platformA     Platform @relation("PlatformA", fields: [platformAId], references: [id], onDelete: Cascade)
  platformB     Platform @relation("PlatformB", fields: [platformBId], references: [id], onDelete: Cascade)

  faqs          ComparisonFAQ[]
  facts         Fact[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ComparisonFAQ {
  id            String     @id @default(cuid())
  question      String
  answer        String     @db.Text
  comparisonId  String
  comparison    Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
}

model Fact {
  id            String     @id @default(cuid())
  text          String     @db.Text
  platform      String // "A", "B", or "Both"
  comparisonId  String
  comparison    Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
}

