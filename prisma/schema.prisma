
// --- Merged from _base.prisma ---
generator client {
  provider   = "prisma-client-js"
}

datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
}


// --- Merged from advertisement.prisma ---
model Advertisement {
    id String @id @default(cuid()) @map("_id")
    type         AdvertisementType @default(IMAGE)
    content      String            
    imageUrl     String?           
    linkUrl      String?           
    placement    AdPlacementType
    active       Boolean           @default(true)
    allowedPages String?            // Comma-separated or "*"
    createdAt    DateTime          @default(now())
    updatedAt    DateTime          @updatedAt

    @@index([placement])
}

enum AdvertisementType {
    SCRIPT
    IMAGE
}

enum AdPlacementType {
    HEADER
    SIDEBAR
    POST_TOP
    POST_BOTTOM
    COMPARISON_BETWEEN
    MOBILE_FIXED_BOTTOM
}


// --- Merged from analytics.prisma ---
model AffiliateClick {
    id String @id @default(cuid()) @map("_id")
    platformId String
    platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
    referrer   String   
    userAgent  String   
    device     String?
    browser    String?
    os         String?
    country    String?
    city       String?
    region     String?
    ip         String
    createdAt  DateTime @default(now())

    @@index([platformId])
}


// --- Merged from community.prisma ---

enum ForumTopicStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ForumPostStatus {
  PENDING
  APPROVED
  REJECTED
}

model ForumCategory {
  id String @id @default(cuid()) @map("_id")
  name        String       @unique
  slug        String       @unique
  description String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  topics      ForumTopic[]
}

model ForumTopic {

  id String @id @default(cuid()) @map("_id")
  title      String
  content    String           
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  authorId   String
  author     User             @relation("TopicAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  categoryId String
  category   ForumCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  posts      ForumPost[]
  status     ForumTopicStatus @default(PENDING)
  votes      TopicVote[]
  platformIds String[]
  platforms  Platform[] @relation(fields: [platformIds], references: [id])

  @@index([authorId])
  @@index([categoryId])
}

model ForumPost {
  id String @id @default(cuid()) @map("_id")
  content   String          
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  authorId  String
  author    User            @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  topicId   String
  topic     ForumTopic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  status    ForumPostStatus @default(PENDING)
  votes     PostVote[]

  @@index([authorId])
  @@index([topicId])
}

model TopicVote {
  id String @id @default(cuid()) @map("_id")
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId String
  topic   ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  value   Int    // 1 or -1

  @@unique([userId, topicId])
  @@index([topicId])
}

model PostVote {
  id String @id @default(cuid()) @map("_id")
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  value  Int    // 1 or -1

  @@unique([userId, postId])
  @@index([postId])
}


// --- Merged from comparison.prisma ---
// comparison.prisma

model Comparison {
  id String @id @default(cuid()) @map("_id")
  title          String
  slug           String     @unique
  summary        String     
  introduction   String     
  content        String?    
  conclusion     String     
  published      Boolean    @default(false)
  platformAId    String
  platformBId    String
  platformA      Platform   @relation("PlatformA", fields: [platformAId], references: [id], onDelete: Cascade)
  platformB      Platform   @relation("PlatformB", fields: [platformBId], references: [id], onDelete: Cascade)
  facts          Fact[]
  faqs           Faq[]
  bookmarks      Bookmark[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  lastVerifiedAt DateTime?

  // Industrial Metadata
  authorName        String?
  authorRole        String?
  authorBio         String?    
  authorCredentials Json?      // Store as array of strings
  metaTitle         String?
  metaDescription   String?    
  sovereigntyScoreA Float?
  sovereigntyScoreB Float?

  // New category relation
  categoryId String?
  category   ComparisonCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([platformAId])
  @@index([platformBId])
  @@index([categoryId])
}

model Fact {
  id String @id @default(cuid()) @map("_id")
  title          String
  platformAValue String
  platformBValue String
  comparisonId   String
  comparison     Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  lastVerifiedAt DateTime?

  @@index([comparisonId])
}

model Faq {
  id String @id @default(cuid()) @map("_id")
  question     String
  answer       String     
  comparisonId String
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([comparisonId])
}


// --- Merged from content.prisma ---
model SiteContent {
  id String @id @default(cuid()) @map("_id")
  key       String      @unique // e.g., "homepage.hero.title"
  value     String      
  group     String // e.g., "Homepage", "Footer"
  type      ContentType @default(TEXT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum ContentType {
  TEXT
  TEXTAREA
  MARKDOWN
}

model PostCategory {
  id String @id @default(cuid()) @map("_id")
  slug  String @unique
  name  String
  posts Post[]
}

model ComparisonCategory {
  id String @id @default(cuid()) @map("_id")
  slug        String       @unique
  name        String
  comparisons Comparison[]
}

model Post {

  id String @id @default(cuid()) @map("_id")
  title       String
  slug        String     @unique
  description String     
  content     String     
  image       String
  dataAiHint  String?    
  published   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  comments    Comment[]
  bookmarks   Bookmark[]

  // Meta SEO
  metaTitle       String?    
  metaDescription String?    
  keywords        String?    

  // High-fidelity Author Info
  authorRole        String?    
  authorBio         String?    
  authorCredentials String?    

  // Engagement Materials
  keyTakeaways Json?
  checklist    Json?
  facts        PostFact[]
  faqs         PostFaq[]
  sources      PostSource[]

  // New category relation
  categoryId String?
  category   PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // For post navigation
  previousId String? @unique
  nextId     String? @unique

  previous Post? @relation("PostNavigation")
  next     Post? @relation("PostNavigation", fields: [nextId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  platformIds String[]
  platforms  Platform[] @relation(fields: [platformIds], references: [id])

  @@index([authorId])
  @@index([categoryId])
}

model PostFact {
  id String @id @default(cuid()) @map("_id")
  title     String
  value     String   
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
}

model PostFaq {
  id String @id @default(cuid()) @map("_id")
  question  String
  answer    String   
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
}

model PostSource {
  id String @id @default(cuid()) @map("_id")
  title     String
  url       String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
}

model Comment {
  id String @id @default(cuid()) @map("_id")
  content   String        
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  status    CommentStatus @default(PENDING)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  @@index([authorId])
  @@index([postId])
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Bookmark {
  id String @id @default(cuid()) @map("_id")
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  comparisonId String?
  comparison   Comparison? @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, comparisonId])
}


model LegalDocument {
  id String @id @default(cuid()) @map("_id")
  title     String
  slug      String   @unique
  content   String   
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// --- Merged from email.prisma ---

model EmailCampaign {
  id String @id @default(cuid()) @map("_id")
  subject         String
  content         String          
  status          CampaignStatus  @default(PENDING)
  createdAt       DateTime        @default(now())
  sentAt          DateTime?
  recipients      EmailRecipient[]
  excludedUserIds String?         
}

model EmailRecipient {
  id String @id @default(cuid()) @map("_id")
  campaignId  String
  userId      String
  status      RecipientStatus @default(PENDING)
  sentAt      DateTime?
  errorMessage String?
  campaign    EmailCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
}

model ContactMessage {
  id String @id @default(cuid()) @map("_id")
  name      String
  email     String
  message   String   
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscription {
  id String @id @default(cuid()) @map("_id")
  email     String   @unique
  createdAt DateTime @default(now())
}


enum CampaignStatus {
  PENDING
  SENDING
  SENT
}

enum RecipientStatus {
  PENDING
  SUCCESS
  FAILED
}


// --- Merged from image.prisma ---
model Image {
  id String @id @default(cuid()) @map("_id")
  filename  String
  url       String
  altText   String?
  size      Int
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation("UploadedBy", fields: [authorId], references: [id], onDelete: Cascade)
}


// --- Merged from news.prisma ---
model NewsArticle {

  id String @id @default(cuid()) @map("_id")
  slug       String     @unique
  title      String
  content    String     
  image      String
  dataAiHint String?
  published  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  authorId   String
  author     User       @relation("AuthoredNews", fields: [authorId], references: [id], onDelete: Cascade)
  platformIds String[]
  platforms  Platform[] @relation(fields: [platformIds], references: [id])
}


// --- Merged from notification.prisma ---
model Notification {
  id String @id @default(cuid()) @map("_id")
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  link      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
}

enum NotificationType {
  NEW_USER_REGISTERED
  COMMENT_APPROVED
  NEW_COMMENT_AWAITING_APPROVAL
  NEW_FORUM_CONTENT
}


// --- Merged from platform.prisma ---
model Platform {



  id String @id @default(cuid()) @map("_id")
  name                  String            @unique
  website               String            
  logoUrl               String            
  description           String            
  rating                Float?
  easeOfUse             Float?
  featuresRating        Float?
  support               Float?
  features              PlatformFeature[]
  comparisonsA          Comparison[]      @relation("PlatformA")
  comparisonsB          Comparison[]      @relation("PlatformB")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  lastVerifiedAt        DateTime?
  
  // High-fidelity data fields
  pros                  Json?             // Array of strings or objects
  cons                  Json?             // Array of strings or objects
  affiliateLink         String?           
  dealDescription       String?
  videoHostingIncluded  Boolean?
  
  // Phase 3 Creator Intelligence metrics
  valueRating           Float?            // Value / Pricing Pillar (0-5)
  sovereigntyRating     Float?            // Data / Platform Sovereignty Pillar (0-5)
  integrationsRating    Float?            // Ecosystem & Integrations Pillar (0-5)
  category              String?           // Category e.g. "Newsletter", "E-commerce", "Community", "LMS", "Workspace"
  changeLogs            PlatformChangeLog[]

  // Relations
  tiers                 PricingTier[]
  newsArticleIds String[]
  newsArticles  NewsArticle[] @relation(fields: [newsArticleIds], references: [id])
  postIds String[]
  posts  Post[] @relation(fields: [postIds], references: [id])
  forumTopicIds String[]
  forumTopics  ForumTopic[] @relation(fields: [forumTopicIds], references: [id])
  affiliateClicks       AffiliateClick[]
  stackPlatforms        StackPlatform[]
  currentReviews        CreatorReview[]   @relation("CurrentPlatformReviews")
  previousReviews       CreatorReview[]   @relation("PreviousPlatformReviews")

  // Deprecated fields (keeping for migration safety, will remove later)
  transactionFeePercent Float?
  flatMonthlyFee        Float?
}

model PricingTier {
  id String @id @default(cuid()) @map("_id")
  name                          String
  monthlyPrice                  Float
  annualPriceMonthlyEquivalent  Float?
  transactionFeePercent         Float?
  isPopular                     Boolean  @default(false)
  features                      Json?    // Optional list of key features for this specific tier
  platformId                    String
  platform                      Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@index([platformId])
}

model FeatureCategory {
  id String @id @default(cuid()) @map("_id")
  name      String    @unique
  features  Feature[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Feature {
  id String @id @default(cuid()) @map("_id")
  name       String
  categoryId String
  category   FeatureCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  platforms  PlatformFeature[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([categoryId])
}

model PlatformFeature {
  id String @id @default(cuid()) @map("_id")
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  featureId  String
  feature    Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  hasFeature Boolean
  details    String?

  @@unique([platformId, featureId])
  @@index([featureId])
}

model PlatformChangeLog {
  id String @id @default(cuid()) @map("_id")
  platformId  String
  platform    Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  title       String
  description String   
  type        String   // "PRICING" | "FEATURE" | "FEE_UPDATE" | "SECURITY" | "INTEGRATION"
  sourceUrl   String?  

  @@index([platformId])
}


// --- Merged from project.prisma ---
enum ProjectStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

model Project {
  id String @id @default(cuid()) @map("_id")
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  matchProfile MatchProfile?
  savedStacks  UserStack[]
  
  // Storage for snapshots of calculations
  roiSnapshots   Json?
  churnSnapshots Json?
  adSnapshots    Json?
}

model MatchProfile {
  id String @id @default(cuid()) @map("_id")
  revenue          Float
  studentCount     Int
  technicalSkill   Int
  requiredFeatures Json     // Array of feature IDs
  monthlyBudget    Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}


// --- Merged from review.prisma ---
// review.prisma

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum VerificationStatus {
  COMMUNITY
  EXPERIENCED
  VERIFIED
}

enum SourceType {
  FIRST_PARTY
  OFFICIAL_API
  PARTNER
  PUBLIC_PAGE
  MANUAL_RESEARCH
  SEED
}

model CreatorReview {
  id String @id @default(cuid()) @map("_id")
  creatorName           String?
  creatorEmail          String?
  creatorSegment        String                   // "Course Creator", "Newsletter Writer", "Community Builder", "Solopreneur", "Enterprise"
  audienceRange         String                   // "0-1K", "1K-10K", "10K-50K", "50K-100K", "100K+"
  usageDurationMonths   Int
  spendRange            String                   // "$0-$50/mo", "$50-$200/mo", "$200-$500/mo", "$500+/mo"

  currentPlatformId     String
  currentPlatform       Platform                 @relation("CurrentPlatformReviews", fields: [currentPlatformId], references: [id], onDelete: Cascade)

  previousPlatformId    String?
  previousPlatform      Platform?                @relation("PreviousPlatformReviews", fields: [previousPlatformId], references: [id], onDelete: SetNull)

  selectionReason       String                   
  bottleneck            String                   
  recommendationScore   Float                    // 1.0 to 5.0 scale

  status                ReviewStatus             @default(PENDING)
  verificationStatus    VerificationStatus       @default(COMMUNITY)
  sourceType            SourceType               @default(FIRST_PARTY)

  revisions             CreatorReviewRevision[]
  moderationEvents      ReviewModerationEvent[]

  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([currentPlatformId])
  @@index([previousPlatformId])
  @@index([status])
  @@index([verificationStatus])
}

model CreatorReviewRevision {
  id String @id @default(cuid()) @map("_id")
  reviewId              String
  review                CreatorReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  revisionNumber        Int
  recommendationScore   Float
  selectionReason       String        
  bottleneck            String        
  createdAt             DateTime      @default(now())

  @@index([reviewId])
}

model ReviewModerationEvent {
  id String @id @default(cuid()) @map("_id")
  reviewId    String
  review      CreatorReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  action      String        // "SUBMITTED", "APPROVED", "REJECTED", "VERIFICATION_CHANGED", "ARCHIVED"
  actor       String?       // Admin email or "SYSTEM"
  notes       String?       
  createdAt   DateTime      @default(now())

  @@index([reviewId])
}


// --- Merged from stack.prisma ---
model UserStack {
  id String @id @default(cuid()) @map("_id")
  title           String
  description     String          
  isVerified      Boolean         @default(false)
  verificationUrl String?         
  userId          String
  user            User            @relation("UserToStacks", fields: [userId], references: [id], onDelete: Cascade)
  platforms       StackPlatform[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
}

model StackPlatform {
  id String @id @default(cuid()) @map("_id")
  stackId     String
  stack       UserStack @relation(fields: [stackId], references: [id], onDelete: Cascade)
  platformId  String
  platform    Platform  @relation(fields: [platformId], references: [id], onDelete: Cascade)
  role        String    // e.g., "LMS", "EMAIL", "CRM", "COMMUNITY"
  
  @@index([stackId])
  @@index([platformId])
}


// --- Merged from tool.prisma ---

model Tool {
  id String @id @default(cuid()) @map("_id")
  slug                String       @unique
  title               String
  description         String       
  Icon                String
  category            ToolCategory
  enabled             Boolean      @default(true)
  prompt              String       
  inputTopicLabel     String?
  inputContextLabel   String?
  seoContent          String?      
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

enum ToolCategory {
  ContentCreation
  Marketing
  CurriculumDesign
  SEO
  Productivity
  EngagementInteraction
}


// --- Merged from user.prisma ---
model Account {
  id String @id @default(cuid()) @map("_id")
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? 
  access_token      String? 
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? 
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id String @id @default(cuid()) @map("_id")
  name            String?
  email           String?         @unique
  emailVerified   DateTime?
  image           String?
  username        String?         @unique
  bio             String?         
  website         String?
  twitter         String?
  linkedin        String?
  role            Role            @default(USER)
  onboarded       Boolean         @default(false)
  newsletter      Boolean         @default(false)
  suspended       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  accounts        Account[]
  sessions        Session[]
  posts           Post[]
  comments        Comment[]
  bookmarks       Bookmark[]
  newsArticles    NewsArticle[]   @relation("AuthoredNews")  // ✅ must match
  notifications   Notification[]
  forumTopics     ForumTopic[]    @relation("TopicAuthor")
  forumPosts      ForumPost[]     @relation("PostAuthor")
  emailRecipients EmailRecipient[]
  authoredImages  Image[]         @relation("UploadedBy")
  stacks          UserStack[]     @relation("UserToStacks")
  projects        Project[]
  topicVotes      TopicVote[]
  postVotes       PostVote[]
}


model VerificationToken {
  id String @id @default(cuid()) @map("_id")
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


enum Role {
  USER
  AUTHOR
  EDITOR
  MODERATOR
  SUPPORT
  ADMIN
}

