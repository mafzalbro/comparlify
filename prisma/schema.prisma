
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  onboarded     Boolean   @default(false)
  newsletter    Boolean   @default(false)

  accounts     Account[]
  sessions     Session[]
  posts        Post[]
  comments     Comment[]
  bookmarks    Bookmark[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  ADMIN
}

model Platform {
  id             String    @id @default(cuid())
  name           String    @unique
  website        String
  logoUrl        String
  description    String    @db.Text
  rating         Float?
  easeOfUse      Float?
  featuresRating Float?
  support        Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  features     PlatformFeature[]
  comparisonsA Comparison[]      @relation("PlatformA")
  comparisonsB Comparison[]      @relation("PlatformB")
}

model FeatureCategory {
  id   String    @id @default(cuid())
  name String    @unique

  features Feature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feature {
  id         String @id @default(cuid())
  name       String
  categoryId String

  category FeatureCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  platforms PlatformFeature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   @@unique([name, categoryId])
}

model PlatformFeature {
  platformId String
  featureId  String
  hasFeature Boolean
  details    String?

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  feature  Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([platformId, featureId])
}

model Comparison {
  id           String @id @default(cuid())
  title        String @unique
  slug         String @unique
  summary      String @db.Text
  introduction String @db.Text
  conclusion   String @db.Text
  published    Boolean @default(false)
  
  platformAId String
  platformBId String
  
  platformA Platform @relation("PlatformA", fields: [platformAId], references: [id], onDelete: Cascade)
  platformB Platform @relation("PlatformB", fields: [platformBId], references: [id], onDelete: Cascade)
  
  facts Fact[]
  faqs  FAQ[]
  bookmarks Bookmark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fact {
  id             String @id @default(cuid())
  title          String
  platformAValue String
  platformBValue String
  comparisonId   String
  comparison     Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
}

model FAQ {
  id           String @id @default(cuid())
  question     String
  answer       String
  comparisonId String
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  content     String   @db.Text
  image       String
  dataAiHint  String?
  published   Boolean  @default(false)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  previousId String? @unique
  previous   Post?   @relation("PostNavigation", fields: [previousId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nextId     String? @unique
  next       Post?   @relation("PostNavigation", fields: [nextId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  comments  Comment[]
  bookmarks Bookmark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  status    CommentStatus @default(PENDING)
  
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Subscription {
    id String @id @default(cuid())
    email String @unique
    createdAt DateTime @default(now())
}

model Bookmark {
  id String @id @default(cuid())
  userId String
  contentType ContentType
  contentId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [contentId], references: [id], onDelete: Cascade)
  comparison Comparison? @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  @@unique([userId, contentType, contentId])
}

enum ContentType {
  POST
  COMPARISON
}

model Notification {
  id      String @id @default(cu id())
  message String
  link    String
  read    Boolean @default(false)
  type    NotificationType

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum NotificationType {
  NEW_USER
  COMMENT_APPROVED
}
