// comparison.prisma

model Comparison {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  summary        String     @db.Text
  introduction   String     @db.Text
  content        String?    @db.LongText
  conclusion     String     @db.Text
  published      Boolean    @default(false)
  platformAId    String
  platformBId    String
  platformA      Platform   @relation("PlatformA", fields: [platformAId], references: [id], onDelete: Cascade)
  platformB      Platform   @relation("PlatformB", fields: [platformBId], references: [id], onDelete: Cascade)
  facts          Fact[]
  faqs           Faq[]
  bookmarks      Bookmark[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  lastVerifiedAt DateTime?

  // Industrial Metadata
  authorName        String?
  authorRole        String?
  authorBio         String?    @db.Text
  authorCredentials Json?      // Store as array of strings
  metaTitle         String?
  metaDescription   String?    @db.Text
  sovereigntyScoreA Float?
  sovereigntyScoreB Float?

  // New category relation
  categoryId String?
  category   ComparisonCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([platformAId])
  @@index([platformBId])
  @@index([categoryId])
}

model Fact {
  id             String     @id @default(cuid())
  title          String
  platformAValue String
  platformBValue String
  comparisonId   String
  comparison     Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  lastVerifiedAt DateTime?

  @@index([comparisonId])
}

model Faq {
  id           String     @id @default(cuid())
  question     String
  answer       String     @db.Text
  comparisonId String
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([comparisonId])
}
