model Platform {
  id                    String            @id @default(cuid())
  name                  String            @unique
  website               String            @db.VarChar(1024)
  logoUrl               String            @db.VarChar(1024)
  description           String            @db.Text
  rating                Float?
  easeOfUse             Float?
  featuresRating        Float?
  support               Float?
  features              PlatformFeature[]
  comparisonsA          Comparison[]      @relation("PlatformA")
  comparisonsB          Comparison[]      @relation("PlatformB")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  lastVerifiedAt        DateTime?
  
  // High-fidelity data fields
  pros                  Json?             // Array of strings or objects
  cons                  Json?             // Array of strings or objects
  affiliateLink         String?           @db.VarChar(1024)
  dealDescription       String?
  videoHostingIncluded  Boolean?
  
  // Phase 3 Creator Intelligence metrics
  valueRating           Float?            // Value / Pricing Pillar (0-5)
  sovereigntyRating     Float?            // Data / Platform Sovereignty Pillar (0-5)
  integrationsRating    Float?            // Ecosystem & Integrations Pillar (0-5)
  category              String?           // Category e.g. "Newsletter", "E-commerce", "Community", "LMS", "Workspace"
  changeLogs            PlatformChangeLog[]

  // Relations
  tiers                 PricingTier[]
  newsArticles          NewsArticle[]
  posts                 Post[]
  forumTopics           ForumTopic[]
  affiliateClicks       AffiliateClick[]
  stackPlatforms        StackPlatform[]

  // Deprecated fields (keeping for migration safety, will remove later)
  transactionFeePercent Float?
  flatMonthlyFee        Float?
}

model PricingTier {
  id                            String   @id @default(cuid())
  name                          String
  monthlyPrice                  Float
  annualPriceMonthlyEquivalent  Float?
  transactionFeePercent         Float?
  isPopular                     Boolean  @default(false)
  features                      Json?    // Optional list of key features for this specific tier
  platformId                    String
  platform                      Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@index([platformId])
}

model FeatureCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  features  Feature[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Feature {
  id         String            @id @default(cuid())
  name       String
  categoryId String
  category   FeatureCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  platforms  PlatformFeature[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([categoryId])
}

model PlatformFeature {
  id         String   @id @default(cuid())
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  featureId  String
  feature    Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  hasFeature Boolean
  details    String?

  @@unique([platformId, featureId])
  @@index([featureId])
}

model PlatformChangeLog {
  id          String   @id @default(cuid())
  platformId  String
  platform    Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  title       String
  description String   @db.Text
  type        String   // "PRICING" | "FEATURE" | "FEE_UPDATE" | "SECURITY" | "INTEGRATION"
  sourceUrl   String?  @db.VarChar(1024)

  @@index([platformId])
}
