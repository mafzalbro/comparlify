enum ProjectStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  matchProfile MatchProfile?
  savedStacks  UserStack[]
  
  // Storage for snapshots of calculations
  roiSnapshots   Json?
  churnSnapshots Json?
  adSnapshots    Json?
}

model MatchProfile {
  id               String   @id @default(cuid())
  revenue          Float
  studentCount     Int
  technicalSkill   Int
  requiredFeatures Json     // Array of feature IDs
  monthlyBudget    Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
