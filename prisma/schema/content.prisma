
model PostCategory {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  posts Post[]
}

model ComparisonCategory {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  comparisons Comparison[]
}

model Post {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  description  String    @db.VarChar(191)
  content      String    @db.Text
  image        String
  dataAiHint   String?
  published    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId     String
  comments     Comment[]
  bookmarks    Bookmark[]

  // New category relation
  categoryId String?
  category   PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // For post navigation
  previousId String?  @unique
  nextId     String?  @unique
  previous   Post?    @relation("PostNavigation", fields: [previousId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  next       Post?    @relation("PostNavigation", fields: [nextId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([authorId])
  @@index([categoryId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    CommentStatus @default(PENDING)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  @@index([authorId])
  @@index([postId])
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Comparison {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String   @db.Text
  introduction String  @db.Text
  conclusion  String   @db.Text
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  platformA   Platform @relation("PlatformA", fields: [platformAId], references: [id], onDelete: Cascade)
  platformAId String
  platformB   Platform @relation("PlatformB", fields: [platformBId], references: [id], onDelete: Cascade)
  platformBId String
  facts       Fact[]
  faqs        Faq[]
  bookmarks   Bookmark[]

  // New category relation
  categoryId String?
  category   ComparisonCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)


  @@index([platformAId])
  @@index([platformBId])
  @@index([categoryId])
}

model Fact {
  id             String     @id @default(cuid())
  title          String
  platformAValue String
  platformBValue String
  comparison     Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  comparisonId   String

  @@index([comparisonId])
}

model Faq {
  id           String     @id @default(cuid())
  question     String
  answer       String     @db.Text
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  comparisonId String

  @@index([comparisonId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscription {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
