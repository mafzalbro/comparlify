model SiteContent {
  id        String      @id @default(cuid())
  key       String      @unique // e.g., "homepage.hero.title"
  value     String      @db.Text
  group     String // e.g., "Homepage", "Footer"
  type      ContentType @default(TEXT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum ContentType {
  TEXT
  TEXTAREA
  MARKDOWN
}

model PostCategory {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  posts Post[]
}

model ComparisonCategory {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  comparisons Comparison[]
}

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String     @db.VarChar(191)
  content     String     @db.Text
  image       String
  dataAiHint  String?
  published   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  comments    Comment[]
  bookmarks   Bookmark[]

  // Meta SEO
  metaTitle       String?
  metaDescription String?
  keywords        String?

  // High-fidelity Author Info
  authorRole        String?
  authorBio         String?
  authorCredentials String?

  // Engagement Materials
  keyTakeaways Json?
  checklist    Json?
  facts        PostFact[]
  faqs         PostFaq[]

  // New category relation
  categoryId String?
  category   PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // For post navigation
  previousId String? @unique
  nextId     String? @unique

  previous Post? @relation("PostNavigation")
  next     Post? @relation("PostNavigation", fields: [nextId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  platforms Platform[]

  @@index([authorId])
  @@index([categoryId])
}

model PostFact {
  id        String   @id @default(cuid())
  title     String
  value     String   @db.Text
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
}

model PostFaq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
}

model Comment {
  id        String        @id @default(cuid())
  content   String        @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  status    CommentStatus @default(PENDING)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  @@index([authorId])
  @@index([postId])
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Bookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  comparisonId String?
  comparison   Comparison? @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, comparisonId])
}


model LegalDocument {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String   @db.LongText
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
